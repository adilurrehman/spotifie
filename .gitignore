# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example
*.key
*.pem
service-role*
secrets.json

# Local music library (source of truth is the local filesystem, not git)
audio/
songs/**/*.mp3
songs/**/*.m4a
songs/**/*.aac
songs/**/*.flac
songs/**/*.wav
songs/**/*.ogg
songs/**/*.opus
songs/**/*.webm
songs/**/*.mp4

# Local library index and cache (fully rebuildable)
.spotifie/

# Local music root (default MUSIC_ROOT)
music/

# Local user data / runtime state
data/
uploads/
users.json
*.sqlite
*.sqlite3
*.db

# Generated caches, logs, temp
.cache/
dist/
build/
tmp/
temp/
logs/
*.log
npm-debug.log*
.npm/

# The built public release. Generated by "npm run build:public" and published
# by copying it into a separate repository - never committed here.
public-release/dist/

# Backups and archives, which are how a private file usually escapes
backup/
backups/
*.bak
*.backup
*.orig
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Anything named as private, and any dump of it
*.private
*.secret
*.local
dump.sql
*.dump

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
