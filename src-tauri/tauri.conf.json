{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Spotifie",
    "version": "../package.json",
    "identifier": "app.spotifie.desktop",
    "build": {
        "frontendDist": "../desktop/dist",
        "beforeDevCommand": "npm run build:desktop",
        "beforeBuildCommand": ""
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "Spotifie",
                "width": 1280,
                "height": 820,
                "minWidth": 400,
                "minHeight": 600,
                "resizable": true,
                "center": true,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "category": "Music",
        "shortDescription": "Hybrid Local & Global Music Player",
        "longDescription": "Spotifie brings the music already on your device together with a published global catalogue in one library. An independent project, not affiliated with Spotify AB.",
        "copyright": "Spotifie. Not affiliated with, endorsed by or connected to Spotify AB.",
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    }
}
