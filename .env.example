# Copy to .env and fill in. Never commit .env.
# .env holds local configuration only - no audio, no music metadata.

# Local Node server (single origin: frontend + API)
# Set these as environment variables when starting the server.
HOST=127.0.0.1
PORT=3000

# Local music library root (scanned recursively; never the whole machine)
MUSIC_ROOT=./music

# Origins this helper will answer, beyond its own.
#
# This server holds your music library and can be told to search your disks. It
# listens on loopback, which keeps it off the network - but any page in any tab
# can still try to reach it, and what stops them is that it refuses to answer
# anybody it was not told about.
#
# Name your own published copy here to let it read the music on this machine.
# Never "*": that would let any website you visit list, and search, your music.
# SPOTIFIE_ALLOWED_ORIGINS=https://spotifie.example

# Where this installation is published, for canonical URLs, the sitemap and the
# structured record of what this application is. Leave it unset in development:
# with nothing here, and with any address on this machine, nothing claims a
# public address at all - which is the right answer until there is one.
# PUBLIC_SITE_URL=https://example.com

# Supabase (authentication, user profiles and admin authorization only - never audio)
# Both values are public/browser-safe project settings and are served to the
# browser by the local server at /api/config. Defaults live in lib/publicConfig.js.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Never place a service-role key in this project, in .env, or in browser code.
# Administrators are rows in the app_admins table (see supabase-setup.sql),
# not an email address in configuration.
