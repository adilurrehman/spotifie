<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Least privilege. INTERNET, and what playing music in the background
        needs: a media-playback foreground service, and a wake lock so a
        stream does not stop when the screen goes off (ExoPlayer takes it only
        while something is playing). Music folders are reached through the
        Storage Access Framework, which needs no storage permission at all.
        POST_NOTIFICATIONS is deliberately not declared: a media session's
        notification is exempt from it. Nothing is backed up by Android (the
        WebView holds the signed-in session), and nothing travels over plain
        HTTP.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Confirmation and password-reset emails return to the app, not a
                 browser: app.spotifie.android://auth/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.spotifie.android" android:host="auth" android:pathPrefix="/callback" />
            </intent-filter>

        </activity>

        <!--
            The music itself, played by Android rather than by the web view, so
            it keeps playing with the app in the background or the screen off,
            and appears on the lock screen and in the notification shade.
            Media3 builds the media notification; nothing here is hand-made.
            Not exported: only Spotifie and Android's own media buttons reach it.
        -->
        <service
            android:name=".SpotifieMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        The in-app browser library (@capacitor/inappbrowser) declares camera,
        microphone, audio-settings and location permissions for web pages that
        ask for them. Spotifie only shows its own admin dashboard there, which
        uses none of them, so they are taken out of the merged manifest.
        tools/androidBuild.js refuses an APK that asks for anything beyond
        INTERNET.
    -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
</manifest>
