<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing the app keeps leaves the phone through Android backup or device
    transfer. The WebView's storage holds the signed-in session, and the Local
    Music index names the person's own files; neither belongs in a cloud backup.
    A Spotifie backup is the explicit, metadata-only export in the app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
